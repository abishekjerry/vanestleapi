{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",

  // Secrets are NOT stored here. Supply them via:
  //   - Development: dotnet user-secrets set "ConnectionStrings:VADbConnectionString" "..."
  //   - Server/IIS:  environment variables, e.g. ConnectionStrings__VADbConnectionString,
  //                  ApiSettings__ApiKey, ApiSettings__SecretKey, Smtp__Username, Smtp__Password
  "ConnectionStrings": {
    "VADbConnectionString": "Server=10.0.3.12;Database=dbvanestle;user id=pmgvirtualagency;password=pmgvirtualagency@1;TrustServerCertificate=True;"
  },
  "ApiSettings": {
    "ApiKey": "sdjfhgdf9847348dfdHJKD97888JDU99",
    "SecretKey": "dslgjhfg087DFFh50821571gi"
  },
  "Smtp": {
    "Host": "email-smtp.us-west-2.amazonaws.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "virtualagency@pmgasia.com",
    "FromName": "Virtual Agency",
    // Requests arriving on these hosts are treated as non-production: all mail goes to RedirectTo instead
    "RedirectHosts": [ "localhost", "ebiz.pmgasia.com" ],
    "RedirectTo": "va@pmgasia.com,anurekha.m@pmgasia.com,jagdeesan.h@pmgasia.com"
  },
  "Database": {
    "CommandTimeoutSeconds": 60,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "CompatibilityLevel": 140,
    "ReportCommandTimeoutSeconds": 300
  },
  // Optional paging for list endpoints via ?pageNumber=&pageSize= (totals in X-Total-Count / X-Total-Pages headers).
  // DefaultPageSize 0 = clients that send no paging values get the full list, exactly as before.
  "Pagination": {
    "DefaultPageSize": 0
  },
  "RequestLogging": {
    "LogBodies": true,
    "MaxBodyLength": 4096
  },
  "LoginRateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "HostURLS": [
    "http://localhost:5173",
    "http://localhost:5174",
    "https://ebiz.pmgasia.com",
    "https://web.pmgasia.com"
  ]
}
